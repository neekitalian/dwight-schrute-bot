# Local secrets. Copy to .env, chmod 600 .env. Never commit real values.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
DATABENTO_API_KEY=
MASSIVE_API_KEY=
# Optional third-party Benzinga relay, separate from Massive credentials.
# Preparation only; continuous news ingestion is not implemented.
BENZINGA_RELAY_REST=
BENZINGA_RELAY_WS=
BENZINGA_RELAY_KEY=
DWIGHT_DATA_FEED=sip
# Historical SIP may work without real-time subscription; live shadow requires feed access.
