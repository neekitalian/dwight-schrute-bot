# Reviewed starting point, not an installed or validated public endpoint.
# Place the zone declaration in nginx's http context. Supply your own domain,
# valid certificate paths and secure secret management before enabling.
limit_req_zone $binary_remote_addr zone=dwight_observations:10m rate=2r/s;

server {
    listen 443 ssl;
    server_name alerts.example.invalid;
    ssl_certificate /etc/letsencrypt/live/alerts.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/alerts.example.invalid/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    # URL capability is sensitive. This virtual host must not record paths.
    access_log off;
    error_log /dev/null crit;
    client_max_body_size 8k;
    client_body_timeout 2s;
    client_header_timeout 2s;
    keepalive_timeout 5s;

    location /alerts/ {
        limit_req zone=dwight_observations burst=3 nodelay;
        limit_req_status 429;
        limit_except POST { deny all; }
        proxy_request_buffering on;
        proxy_pass http://127.0.0.1:8765;
        proxy_connect_timeout 1s;
        proxy_read_timeout 2s;
        proxy_send_timeout 2s;
        proxy_set_header Host $host;
    }
    location = /healthz {
        proxy_pass http://127.0.0.1:8765;
        proxy_read_timeout 2s;
    }
    location / { return 404; }
}
