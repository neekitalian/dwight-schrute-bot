[Unit]
Description=Dwight private paper console
After=network.target

[Service]
Type=simple
User=dwight
Group=dwight
WorkingDirectory=/opt/dwight
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ExecStart=/opt/dwight/.venv/bin/dwight paper-console --directory /var/lib/dwight/automatic-paper --port 8787
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/dwight

[Install]
WantedBy=multi-user.target
